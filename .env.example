# Copy to .env next to compose.yaml, or let scripts/docker.sh set these for you.

# The folder to work on: absolute path, ideally the root of a git repository.
WORKSPACE=/home/you/my-harnesses

# Host port.
PORT=8000

# LAN access (SPEC FR-35): publish on all interfaces and list the names/IPs other machines use
# (scripts/docker.sh --lan fills this in from scripts/lan-hosts.sh). Default: this machine only.
# BIND_ADDRESS=0.0.0.0
# LOOMVIZ_ALLOWED_HOSTS=my-box,my-box.local,192.168.1.20

# HTTPS: also pass -f compose.tls.yaml (scripts/docker.sh --tls CERT KEY).
# TLS_CERT=/home/you/certs/my-box.pem
# TLS_KEY=/home/you/certs/my-box-key.pem

# Run as your user so saved files belong to you: the output of `id -u` and `id -g`.
# Rootless Docker: use 0 and 0 (container root maps to you).
LOOMVIZ_UID=1000
LOOMVIZ_GID=1000

# Optional: a fixed launch token instead of a new random one each start.
# LOOMVIZ_TOKEN=

# Optional: poll for file changes if edits made outside LoomViz don't show up.
# LOOMVIZ_POLL=1

# SELinux (Fedora, RHEL): also pass -f compose.selinux.yaml (scripts/docker.sh --selinux).
